generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs         AuditLog[]
  assignedJobs      ProductionJob[]
  designAssignments DesignProject[] @relation("DesignAssignments")
}

enum Role {
  ADMIN
  ACCOUNTING
  OPERATOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ============ CUSTOMERS ============

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?
  address      String?
  notes        String?
  portalAccess Boolean   @default(false)
  passwordHash String?
  isApproved   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders         Order[]
  quotes         Quote[]
  designProjects DesignProject[]
}

// ============ INVENTORY ============

model Material {
  id               String       @id @default(cuid())
  name             String
  type             MaterialType
  color            String?
  // Six hex digits, no leading hash. Set from the swatch catalogue or by hand.
  // Colour substitution compares these perceptually, so "Fire Engine Red" and
  // "Red" are a real distance apart instead of both reading as pure red.
  colorHex         String?
  brand            String?
  costPerGram      Float
  // Spool-level pricing (user-facing). costPerGram is derived from these when provided.
  spoolPrice       Float?
  spoolWeightGrams Float?
  density          Float        @default(1.24)
  reorderPoint     Float        @default(500)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  spools             Spool[]
  jobMaterials       JobMaterial[]
  jobMaterialsSliced JobMaterial[]       @relation("SlicedMaterial")
  productComponents  ProductComponent[]
  componentMaterials ComponentMaterial[]
  colourAssignments  ColourOptionSlot[]
}

enum MaterialType {
  PLA
  PETG
  ABS
  TPU
  ASA
  NYLON
  RESIN
  OTHER
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  spools Spool[]
  parts  Part[]
}

model Spool {
  id            String           @id @default(cuid())
  printforgeId  String?          @unique
  materialId    String
  material      Material         @relation(fields: [materialId], references: [id])
  initialWeight Float
  currentWeight Float
  spoolWeight   Float            @default(200)
  lotNumber     String?
  purchasePrice Float?
  purchaseDate  DateTime?
  locationId    String?
  location      StorageLocation? @relation(fields: [locationId], references: [id])
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  jobMaterials JobMaterial[]

  @@index([materialId])
  @@index([isActive])
  @@index([locationId])
}

// ============ NON-PRINTED PARTS ============

// Bought-in hardware consumed per unit rather than per gram: NFC tags, heat-set
// inserts, keyrings, keyboard switches, magnets, packaging, etc. Filament stays
// on the Material/Spool (weight-based) track; this is the discrete-count track.
model Part {
  id           String           @id @default(cuid())
  name         String
  sku          String?          @unique
  category     PartCategory     @default(OTHER)
  description  String?
  unitCost     Float            @default(0) // cost per piece
  stockQty     Int              @default(0)
  reorderPoint Int              @default(0)
  supplier     String?
  locationId   String?
  location     StorageLocation? @relation(fields: [locationId], references: [id])
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  productParts ProductPart[]
  jobParts     JobPart[]

  @@index([isActive])
  @@index([category])
  @@index([locationId])
}

enum PartCategory {
  FASTENER // heat-set inserts, screws, nuts
  ELECTRONICS // NFC tags, LEDs, batteries
  HARDWARE // keyrings, chains, magnets
  SWITCH // keyboard switches
  PACKAGING
  ADHESIVE
  OTHER
}

// BOM line: how many of a Part each unit of a Product consumes.
model ProductPart {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  partId    String
  part      Part    @relation(fields: [partId], references: [id])
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@unique([productId, partId])
  @@index([productId])
}

// Parts actually consumed by a production job. unitCost is snapshotted so past
// job costs stay accurate when part pricing changes later.
model JobPart {
  id        String        @id @default(cuid())
  jobId     String
  job       ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partId    String
  part      Part          @relation(fields: [partId], references: [id])
  quantity  Int
  unitCost  Float
  createdAt DateTime      @default(now())

  @@index([jobId])
  @@index([partId])
}

// ============ PRODUCTS (BOM) ============

model Product {
  id               String   @id @default(cuid())
  name             String
  description      String?
  sku              String?  @unique
  estimatedMinutes Float    @default(0)
  estimatedGrams   Float    @default(0)
  colorChanges     Int      @default(0)
  basePrice        Float    @default(0)
  imageUrl         String?
  isActive         Boolean  @default(true)
  defaultPrinterId String?
  defaultPrinter   Printer? @relation(fields: [defaultPrinterId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants       ProductVariant[]
  components     ProductComponent[]
  parts          ProductPart[]
  productionJobs ProductionJob[]
  priceTiers     PriceTier[]

  baseOptionLabel        String? // label of the standard size when sizes exist, e.g. "Regular"; UI default "Standard"
  baseOptionSellable     Boolean? // customer shop only: offer the standard size when active sizes exist. null/false = not offered (today's shop behaviour)
  standardColourLabel    String? // label of the standard (as-sliced) colour when colours exist, e.g. "Black"; UI default "Standard"
  standardColourSellable Boolean? // customer shop only: offer the standard colour when active colours exist. null/false = not offered
  surplusPolicy          SurplusPolicy       @default(KEEP_FOR_STOCK) // default for extras on the last plate
  images                 ProductImage[]
  colourSlots            ProductColourSlot[]
}

// Staff-set bulk pricing: at minQty and above, the unit price for this product
// drops to unitPrice. Applied on the staff order form only — the customer
// portal keeps charging basePrice regardless.
model PriceTier {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  unitPrice Float
  createdAt DateTime @default(now())

  @@unique([productId, minQty])
  @@index([productId])
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  sku              String?  @unique
  basePrice        Float?
  estimatedMinutes Float?
  estimatedGrams   Float?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems     OrderItem[]
  productionJobs ProductionJob[]

  kind              VariantKind           @default(SIZE) // every existing row becomes a size (§3.1 rule 5)
  components        ProductComponent[]    @relation("VariantComponents") // SIZE only
  colourAssignments ColourOptionSlot[] // COLOUR only
  sizeExclusions    ColourSizeExclusion[] // COLOUR only: sizes this colour isn't made in
  priceTiers        VariantPriceTier[] // SIZE only

  @@index([productId])
}

model ProductComponent {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material? @relation(fields: [materialId], references: [id])
  description   String
  gramsUsed     Float
  printMinutes  Float     @default(0)
  quantity      Int       @default(1)
  sortOrder     Int       @default(0)
  stockOnHand   Int       @default(0)
  isMultiColor  Boolean   @default(false)
  // The slicer file this component was onboarded from. Kept so a production
  // job can pre-fill its filename and colour changes, and so the operator can
  // download the exact file to print. attachmentId points at the stored bytes.
  gcodeFilename String?
  colorChanges  Int       @default(0)
  attachmentId  String?
  // Plate calibration for bulk costing: slicing a FULL plate of this component
  // measures how setup and colour-change time amortise across units — the real
  // per-unit cost at volume, not printMinutes x quantity.
  platedUnits   Int?
  platedMinutes Float?
  platedGrams   Float?
  createdAt     DateTime  @default(now())

  materials      ComponentMaterial[]
  productionJobs ProductionJob[]

  variantId                    String? // null = standard-size component; set = owned by that SIZE option
  variant                      ProductVariant?          @relation("VariantComponents", fields: [variantId], references: [id], onDelete: Cascade)
  colourSlotId                 String? // single-material components only: colour slot this filament follows
  colourSlot                   ProductColourSlot?       @relation(fields: [colourSlotId], references: [id], onDelete: SetNull)
  colourFixed                  Boolean? // single-material only: true = fixed on purpose; null/false with colourSlotId null = unlinked (§0.3)
  stockConfirmedAt             DateTime? // null on every pre-release component: its stockOnHand may hold units of other colours; set on create for new components
  thumbnailAttachmentId        String? // 3MF plate render (staff-only, never a photo)
  platedMigratedAt             DateTime? // backfill marker for plated* -> PlateLayout
  perUnitEstimatedFromLayoutId String? // no FK. Set when per-unit grams/minutes were divided out of a xN plate at import; cleared by any grams/minutes edit
  plateLayouts                 PlateLayout[]
  colourStock                  ComponentColourStock[]
  stockMovements               ComponentStockMovement[]
  jobPlates                    JobPlate[]

  @@index([productId, variantId])
  @@index([colourSlotId])
}

model ComponentMaterial {
  id          String           @id @default(cuid())
  componentId String
  component   ProductComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material         @relation(fields: [materialId], references: [id])
  gramsUsed   Float
  colorIndex  Int              @default(0)
  sortOrder   Int              @default(0)

  colourSlotId String? // multicolour: colour slot this tool/colour index follows
  colourSlot   ProductColourSlot? @relation(fields: [colourSlotId], references: [id], onDelete: SetNull)
  colourFixed  Boolean? // true = fixed on purpose; null/false with colourSlotId null = unlinked (§0.3)

  @@unique([componentId, colorIndex])
  @@index([colourSlotId])
}

// ============ PRINTERS ============

model Printer {
  id               String                @id @default(cuid())
  name             String
  model            String?
  connectionType   PrinterConnectionType
  moonrakerUrl     String?
  cameraUrl        String? // MJPEG stream URL (e.g. http://192.168.x.x:8000)
  hourlyRate       Float                 @default(0.40)
  wattage          Float                 @default(200)
  markupMultiplier Float                 @default(2.5)
  isActive         Boolean               @default(true)
  status           PrinterStatus         @default(OFFLINE)
  lastSeen         DateTime?

  // Maintenance tracking
  totalPrintHours           Float     @default(0)
  maintenanceIntervalHours  Float?
  nextMaintenanceDue        DateTime? // kept for calendar-based reminders; overdue uses print-hour delta
  lastMaintenancePrintHours Float     @default(0) // totalPrintHours at time of last completed maintenance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionJobs  ProductionJob[]
  defaultProducts Product[]
  maintenanceLogs MaintenanceLog[]

  @@index([connectionType, isActive])
}

model MaintenanceLog {
  id              String          @id @default(cuid())
  printerId       String
  printer         Printer         @relation(fields: [printerId], references: [id], onDelete: Cascade)
  type            MaintenanceType
  description     String
  scheduledDate   DateTime?
  completedDate   DateTime?
  downtimeMinutes Int?
  cost            Float?
  performedById   String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([printerId])
}

enum MaintenanceType {
  SCHEDULED
  UNSCHEDULED
  CALIBRATION
}

enum PrinterConnectionType {
  MOONRAKER
  CREALITY_WS
  CREALITY_CLOUD
  MANUAL
}

enum PrinterStatus {
  IDLE
  PRINTING
  PAUSED
  ERROR
  OFFLINE
  MAINTENANCE
}

// ============ PRODUCTION ============

model ProductionJob {
  id                String            @id @default(cuid())
  name              String
  status            JobStatus         @default(QUEUED)
  printerId         String?
  printer           Printer?          @relation(fields: [printerId], references: [id])
  assignedToId      String?
  assignedTo        User?             @relation(fields: [assignedToId], references: [id])
  orderId           String?
  order             Order?            @relation(fields: [orderId], references: [id])
  orderItemId       String?
  orderItem         OrderItem?        @relation(fields: [orderItemId], references: [id])
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id])
  componentId       String?
  component         ProductComponent? @relation(fields: [componentId], references: [id])
  quantityToProduce Int               @default(1)
  // Why this job exists. TEST/SAMPLE/WASTE prints still consume filament and
  // parts, but are excluded from revenue and cost-of-sales reporting so they
  // don't distort margins.
  purpose           JobPurpose        @default(CUSTOMER)

  printDuration  Float?
  filamentUsedMm Float?

  colorChanges    Int   @default(0)
  purgeWasteGrams Float @default(0)

  materialCost Float?
  machineCost  Float?
  wasteCost    Float?
  overheadCost Float?
  totalCost    Float?

  moonrakerJobId String?
  gcodeFilename  String?

  // Failed print tracking
  failureReason String?
  failedAt      DateTime?
  wasteGrams    Float           @default(0)
  reprintOfId   String?
  reprintOf     ProductionJob?  @relation("Reprints", fields: [reprintOfId], references: [id])
  reprints      ProductionJob[] @relation("Reprints")

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  materials   JobMaterial[]
  parts       JobPart[]
  attachments Attachment[]

  // Option pair (variantId kept: legacy source, rollback mirror = sizeOptionId ?? colourOptionId)
  sizeOptionId   String? // no FK. null = standard size, or a legacy job (read variantId)
  colourOptionId String? // no FK. null = standard colour, or a legacy job
  surplusPolicy  SurplusPolicy? // resolved at creation; null = legacy job (no plates)
  stockMode      JobStockMode? // only for jobs without orderId; null = DIRECT_SALE semantics
  plates         JobPlate[]

  @@index([sizeOptionId])
  @@index([colourOptionId])
  @@index([status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([reprintOfId])
  @@index([printerId])
  @@index([printerId, status])
  @@index([completedAt])
}

enum JobStatus {
  QUEUED
  IN_PROGRESS
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobPurpose {
  CUSTOMER // real work — counts toward cost of sales
  TEST // calibration / test print
  SAMPLE // giveaway or showcase piece
  WASTE // reprint of a failure, purge, etc.
}

model JobMaterial {
  id               String        @id @default(cuid())
  jobId            String
  job              ProductionJob @relation(fields: [jobId], references: [id])
  materialId       String
  material         Material      @relation(fields: [materialId], references: [id])
  spoolId          String?
  spool            Spool?        @relation(fields: [spoolId], references: [id])
  gramsUsed        Float
  costPerGram      Float
  colorIndex       Int           @default(0)
  // Set when the customer changed colour after slicing: what the file was
  // actually sliced with, so the swap stays visible on the picking list.
  slicedMaterialId String?
  slicedMaterial   Material?     @relation("SlicedMaterial", fields: [slicedMaterialId], references: [id])
  createdAt        DateTime      @default(now())

  // Identity of the planned need this line fulfils, written once at creation and never changed
  // (swapColour and spool substitution change materialId only). Both null = line added by hand or legacy.
  plannedMaterialId       String? // no FK. resolved slot material the line was planned for (the colour option's filament)
  plannedSlicedMaterialId String? // no FK. the component's own material the file was sliced with, when it differs from plannedMaterialId

  @@index([jobId])
  @@index([materialId])
}

// ============ ORDERS ============

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        QuoteStatus @default(DRAFT)
  source        QuoteSource @default(MANUAL)
  subtotal      Float       @default(0)
  tax           Float       @default(0)
  total         Float       @default(0)
  notes         String?
  validUntil    DateTime?
  gcodeMetadata Json?
  stlMetadata   Json?
  costBreakdown Json?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         QuoteItem[]
  order         Order?
  attachments   Attachment[]
  designProject DesignProject?

  @@index([status])
  @@index([customerId])
}

enum QuoteSource {
  MANUAL
  QUICK_QUOTE
  CUSTOMER
  DESIGN
  LINK
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id               String   @id @default(cuid())
  quoteId          String
  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId        String?
  description      String
  quantity         Int      @default(1)
  unitPrice        Float
  totalPrice       Float
  estimatedGrams   Float?
  estimatedMinutes Float?
  estimatedColors  Int?
  estimatedCost    Float?
  marginPercent    Float?
  createdAt        DateTime @default(now())

  sizeOptionId        String? // no FK. null = standard size
  colourOptionId      String? // no FK. null = standard colour
  listUnitPrice       Float?
  priceSource         PriceSource?
  tierMinQty          Int?
  priceOverrideReason String?

  @@index([quoteId])
  @@index([sizeOptionId])
  @@index([colourOptionId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  quoteId     String?     @unique
  quote       Quote?      @relation(fields: [quoteId], references: [id])
  status      OrderStatus @default(PENDING)
  subtotal    Float       @default(0)
  tax         Float       @default(0)
  total       Float       @default(0)
  paidAmount  Float       @default(0)
  notes       String?
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items          OrderItem[]
  productionJobs ProductionJob[]
  invoices       Invoice[]
  attachments    Attachment[]
  configOrders   ConfigOrder[]

  @@index([status])
  @@index([customerId])
}

// ============ CONFIGURATOR ARTIFACTS ============

// A parametric-configurator submission tied to an order. The customer sends
// ONLY params; the server regenerates the artifact from them. params is the
// source of truth — artifacts are derived data and can be re-generated.
model ConfigOrder {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  generatorKey String
  params       Json // validated parameter set (source of truth)
  status       String   @default("GENERATED") // GENERATED | FAILED
  createdAt    DateTime @default(now())

  artifacts ConfigArtifact[]

  @@index([orderId])
}

// A single generated file (.stl / .3mf). storageKey is a server-generated
// opaque token used as the on-disk name — NO customer input ever reaches the
// path. filename is the human-friendly name for Content-Disposition only.
model ConfigArtifact {
  id            String      @id @default(cuid())
  configOrderId String
  configOrder   ConfigOrder @relation(fields: [configOrderId], references: [id], onDelete: Cascade)
  filename      String // validated, for download header only — never a path
  mime          String
  sizeBytes     Int
  storageKey    String      @unique // opaque random token = on-disk filename
  createdAt     DateTime    @default(now())

  @@index([configOrderId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  description  String
  quantity     Int             @default(1)
  unitPrice    Float
  totalPrice   Float
  materialCost Float?
  createdAt    DateTime        @default(now())

  productionJobs ProductionJob[]

  // Option pair (variantId kept: legacy source, rollback mirror = sizeOptionId ?? colourOptionId)
  sizeOptionId        String? // no FK. null = standard size, or a legacy line (read variantId)
  colourOptionId      String? // no FK. null = standard colour, or a legacy line
  listUnitPrice       Float?
  priceSource         PriceSource? // null = line created before this release
  tierMinQty          Int? // tier that applied (TIER) or would have applied (MANUAL)
  priceOverrideReason String?

  @@index([orderId])
  @@index([productId])
  @@index([sizeOptionId])
  @@index([colourOptionId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float
  tax           Float
  total         Float
  paidAmount    Float         @default(0)
  issuedAt      DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attachments  Attachment[]
  transactions AccountTransaction[]

  @@index([status, paidAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// ============ ACCOUNTING ============

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  expenses Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  description String
  amount      Float
  date        DateTime
  recurring   Boolean         @default(false)
  notes       String?
  // Which account the money left. Optional so historical expenses recorded
  // before accounts existed stay valid.
  accountId   String?
  account     Account?        @relation(fields: [accountId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions AccountTransaction[]

  @@index([categoryId])
  @@index([date])
  @@index([accountId])
}

// ============ ACCOUNTS ============

// A place money actually sits — a bank account, the cash box, a card.
// `balance` is a running total kept in step with AccountTransaction, so the
// current figure is one read rather than a sum over all history.
model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType @default(BANK)
  // Free-text: IBAN, last 4 digits, whatever identifies it.
  reference String?
  balance   Float       @default(0)
  // Where invoice payments land unless told otherwise. Only one may be true.
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions AccountTransaction[]
  expenses     Expense[]

  @@index([isActive])
}

enum AccountType {
  BANK
  CASH
  CARD
  OTHER
}

// Every movement of money, positive in and negative out.
//
// `balanceAfter` snapshots the running balance at the time, so a statement
// reads correctly even after later edits, and a drifted Account.balance can be
// spotted against it.
model AccountTransaction {
  id           String          @id @default(cuid())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Positive credits the account, negative debits it.
  amount       Float
  balanceAfter Float
  type         TransactionType
  description  String
  // Human reference — invoice number, receipt number.
  reference    String?
  invoiceId    String?
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  expenseId    String?
  expense      Expense?        @relation(fields: [expenseId], references: [id])
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([accountId, occurredAt])
  @@index([invoiceId])
  @@index([expenseId])
}

enum TransactionType {
  INVOICE_PAYMENT
  EXPENSE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_BALANCE
}

// ============ FILE MANAGEMENT ============

model Attachment {
  id             String   @id @default(cuid())
  filename       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  entityType     String
  entityId       String
  parsedMetadata Json?
  uploadedById   String?
  createdAt      DateTime @default(now())

  // Polymorphic relation — entityType + entityId reference different tables
  // (Quote, Order, ProductionJob, DesignProject, Invoice) without FK constraints
  quoteId         String?
  quote           Quote?         @relation(fields: [quoteId], references: [id])
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id])
  jobId           String?
  productionJob   ProductionJob? @relation(fields: [jobId], references: [id])
  designProjectId String?
  designProject   DesignProject? @relation(fields: [designProjectId], references: [id])
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])

  photoMigratedAt DateTime? // backfill marker (photo copied, thumbnail linked, or skipped)

  @@index([entityType, entityId])
}

// ============ DESIGN MODULE (groundwork) ============

model DesignProject {
  id                String        @id @default(cuid())
  projectNumber     String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  assignedToId      String?
  assignedTo        User?         @relation("DesignAssignments", fields: [assignedToId], references: [id])
  status            DesignStatus  @default(REQUESTED)
  title             String
  brief             String?
  budget            Float?
  quotedPrice       Float?
  designFeeType     DesignFeeType @default(FLAT)
  designFeeAmount   Float?
  designFeeHours    Float?
  totalDesignFee    Float?
  estimatedDelivery DateTime?
  quoteId           String?       @unique
  quote             Quote?        @relation(fields: [quoteId], references: [id])
  deadline          DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  revisions   DesignRevision[]
  comments    DesignComment[]
  attachments Attachment[]

  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
}

enum DesignFeeType {
  FLAT
  HOURLY
}

enum DesignStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  QUOTED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model DesignRevision {
  id            String        @id @default(cuid())
  projectId     String
  project       DesignProject @relation(fields: [projectId], references: [id])
  versionNumber Int
  description   String?
  internalNotes String?
  customerNotes String?
  createdAt     DateTime      @default(now())

  comments DesignComment[]
}

model DesignComment {
  id            String          @id @default(cuid())
  projectId     String
  project       DesignProject   @relation(fields: [projectId], references: [id])
  revisionId    String?
  revision      DesignRevision? @relation(fields: [revisionId], references: [id])
  authorId      String?
  authorName    String
  isCustomer    Boolean         @default(false)
  content       String
  attachmentIds String[]
  createdAt     DateTime        @default(now())
}

// A filament swatch from the bundled filamentcolors.xyz snapshot (CC BY 4.0).
// Reference data only — picking one fills in a Material, it never becomes
// stock itself. Refreshed by scripts/fetch-filament-catalog.mjs.
model FilamentCatalog {
  id     Int     @id
  brand  String
  colour String
  type   String
  family String?
  hex    String
  hotEnd Int?
  bed    Int?

  @@index([brand])
  @@index([colour])
}

// ============ SYSTEM ============

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ============ ADDONS ============

// An operator-uploaded mini-app served in an iframe under /addons/{slug}.
// Static files live on disk at ${UPLOAD_DIR}/addons/{slug}/; this row is the
// registry entry that drives the sidebar and the addon host page.
model Addon {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  icon            String? // lucide-react icon name, e.g. "Type"
  version         String   @default("0.0.0")
  entry           String   @default("index.html")
  isActive        Boolean  @default(true)
  // Whether customers can see and open this addon in the portal. Defaults to
  // false so a newly uploaded addon is staff-only until explicitly published —
  // internal tools (e.g. 3mf-orca-prep) simply stay off.
  customerVisible Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  userId     String?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  LOW_STOCK
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  JOB_COMPLETED
  JOB_FAILED
  INVOICE_OVERDUE
  DESIGN_REVISION_UPLOADED
  DESIGN_APPROVED
  DESIGN_CHANGES_REQUESTED
  MAINTENANCE_DUE
  SYSTEM
}

// ============ PRODUCT REWORK (sizes & colours, plate layouts, printed stock, photos) ============

enum VariantKind {
  SIZE
  COLOUR
}

enum SurplusPolicy {
  CANCEL_ON_PRINTER
  KEEP_FOR_STOCK
}

enum PriceSource {
  BASE // standard size list price
  SIZE // a size option's list price
  TIER
  MANUAL
}

enum StockMovementReason {
  MANUAL_ADJUST
  PLAN_ALLOCATE
  PLAN_RELEASE // order cancelled: allocated units returned
  JOB_COMPLETE_STOCK
  JOB_COMPLETE_SURPLUS
  FILAMENT_REKEY // base filament changed: balance moved between colour keys
}

enum JobStockMode {
  BUILD_STOCK // no order: every printed unit goes to printed stock
  DIRECT_SALE // no order in the system, units handed to a customer: only extras go to stock
}

enum PlateLayoutSource {
  GCODE
  MANUAL
  CALIBRATION
}

// Bulk tiers of a SIZE option. The standard size keeps using PriceTier. Colours have no tiers.
model VariantPriceTier {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQty    Int
  unitPrice Float
  createdAt DateTime       @default(now())

  @@unique([variantId, minQty])
  @@index([variantId])
}

// A named colour role of a product ("Tin", "Trim"). Component material slots of ANY size link to it,
// so one colour option recolours every size. 0-12 per product.
model ProductColourSlot {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String // 1-40 chars; unique per product, case-insensitive (checked in the service)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  components         ProductComponent[]
  componentMaterials ComponentMaterial[]
  assignments        ColourOptionSlot[]

  @@unique([productId, name])
  @@index([productId])
}

// COLOUR option: the filament one product colour slot prints in for this colour.
// Absent row = that slot prints in each linked component's own (as-sliced) filament.
model ColourOptionSlot {
  id           String            @id @default(cuid())
  variantId    String // a COLOUR option of the slot's product
  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  colourSlotId String
  colourSlot   ProductColourSlot @relation(fields: [colourSlotId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material          @relation(fields: [materialId], references: [id]) // Restrict: a filament used by a colour can't be deleted (P2003 -> 400)

  @@unique([variantId, colourSlotId])
  @@index([colourSlotId])
  @@index([materialId])
}

// COLOUR option: a size this colour is NOT made in ("Made in" checklist). No row = made in that size.
// sizeKey = the SIZE option id, or the literal 'standard' for the standard size (a null would not be unique in Postgres).
// No FK on sizeKey: size delete and kind changes delete the rows that name a removed or reclassified size in the same transaction.
model ColourSizeExclusion {
  id        String         @id @default(cuid())
  variantId String // the COLOUR option
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sizeKey   String
  createdAt DateTime       @default(now())

  @@unique([variantId, sizeKey])
  @@index([sizeKey])
}

// Printed-unit stock of a component in a colour key other than its current base key.
// Keyed by physical colour, not by option: two colours that give a component the same
// filament share stock, and changing a colour's assignments never strands stock.
// Invariant (kept by ProductStockService.rekeyBase): no row with stockOnHand > 0 has
// colourKey equal to the component's current base key.
model ComponentColourStock {
  id          String           @id @default(cuid())
  componentId String
  component   ProductComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  colourKey   String // "0:<materialId>" or "0:<id>|1:<id>", sorted by colorIndex
  stockOnHand Int              @default(0)
  updatedAt   DateTime         @updatedAt

  @@unique([componentId, colourKey])
}

// Ledger of every change to a stock bucket. Balance lives on ProductComponent.stockOnHand
// (when the key was the base key at the time of the movement) or ComponentColourStock.stockOnHand.
// colourKey is ALWAYS the physical colour of the units moved, never null.
model ComponentStockMovement {
  id           String              @id @default(cuid())
  componentId  String
  component    ProductComponent    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  colourKey    String // physical colour key of the units (never null; new table, so no legacy rows)
  baseColumn   Boolean             @default(false) // true = this movement changed ProductComponent.stockOnHand; false = a ComponentColourStock row
  delta        Int
  balanceAfter Int
  reason       StockMovementReason
  orderItemId  String? // no FK
  jobId        String? // no FK
  userId       String?
  note         String?
  createdAt    DateTime            @default(now())

  @@index([componentId, colourKey, createdAt])
  @@index([orderItemId, componentId])
  @@index([jobId])
}

model PlateLayout {
  id            String            @id @default(cuid())
  componentId   String
  component     ProductComponent  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  name          String // default "x{unitsPerPlate}"
  unitsPerPlate Int // 1..500
  plateMinutes  Float // 1..100000
  plateGrams    Float // 0.1..100000, slicer total incl. flush and tower
  colorChanges  Int               @default(0)
  source        PlateLayoutSource @default(MANUAL)
  attachmentId  String? // stored G-code (Attachment, entityType 'product')
  gcodeFilename String?
  objectCount   Int? // what the file's object labels said; null = no labels / manual
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  slots         PlateLayoutSlot[]
  jobPlates     JobPlate[]

  @@index([componentId, isActive])
}

model PlateLayoutSlot {
  id         String      @id @default(cuid())
  layoutId   String
  layout     PlateLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  colorIndex Int
  gramsUsed  Float

  @@unique([layoutId, colorIndex])
}

// Snapshot of the plates a job prints. One row per (component, layout) with a count.
model JobPlate {
  id            String            @id @default(cuid())
  jobId         String
  job           ProductionJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  componentId   String?
  component     ProductComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  layoutId      String? // null = implicit single
  layout        PlateLayout?      @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  colourKey     String // planned colour key (display and planning only; completion derives the actual key)
  slots         Json // planned per slot: [{ colorIndex, materialId, slicedMaterialId: string|null, colourSlotId: string|null, gramsPerPlate }]
  label         String // e.g. "Box x12" or "Box single"
  unitsPerPlate Int
  plateCount    Int
  unitsRequired Int // units of this component the job must deliver (same on every row of the component)
  plateMinutes  Float
  plateGrams    Float
  attachmentId  String?
  gcodeFilename String?
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())

  @@index([jobId])
  @@index([layoutId])
}

// Customer-visible product photos only. Never slicer files, never plate renders.
model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey         String   @unique // "<cuid>.<jpg|png|webp>" under ${UPLOAD_DIR}/product-images/
  mimeType           String // sniffed: image/jpeg | image/png | image/webp
  sizeBytes          Int
  width              Int
  height             Int
  originalName       String // sanitised display name, never a path
  sortOrder          Int      @default(0) // lowest = cover
  uploadedById       String?
  legacyAttachmentId String?  @unique
  createdAt          DateTime @default(now())

  @@index([productId, sortOrder])
}
