generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(OPERATOR)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs            AuditLog[]
  assignedJobs         ProductionJob[]
  designAssignments    DesignProject[] @relation("DesignAssignments")
}

enum Role {
  ADMIN
  ACCOUNTING
  OPERATOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ============ CUSTOMERS ============

model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  phone         String?
  address       String?
  notes         String?
  portalAccess  Boolean  @default(false)
  passwordHash  String?
  isApproved    Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders         Order[]
  quotes         Quote[]
  designProjects DesignProject[]
}

// ============ INVENTORY ============

model Material {
  id               String       @id @default(cuid())
  name             String
  type             MaterialType
  color            String?
  brand            String?
  costPerGram      Float
  // Spool-level pricing (user-facing). costPerGram is derived from these when provided.
  spoolPrice       Float?
  spoolWeightGrams Float?
  density          Float        @default(1.24)
  reorderPoint     Float        @default(500)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  spools              Spool[]
  jobMaterials        JobMaterial[]
  productComponents   ProductComponent[]
  componentMaterials  ComponentMaterial[]
}

enum MaterialType {
  PLA
  PETG
  ABS
  TPU
  ASA
  NYLON
  RESIN
  OTHER
}

model StorageLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  spools      Spool[]
  parts       Part[]
}

model Spool {
  id              String           @id @default(cuid())
  printforgeId    String?          @unique
  materialId      String
  material        Material         @relation(fields: [materialId], references: [id])
  initialWeight   Float
  currentWeight   Float
  spoolWeight     Float            @default(200)
  lotNumber       String?
  purchasePrice   Float?
  purchaseDate    DateTime?
  locationId      String?
  location        StorageLocation? @relation(fields: [locationId], references: [id])
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  jobMaterials    JobMaterial[]

  @@index([materialId])
  @@index([isActive])
  @@index([locationId])
}

// ============ NON-PRINTED PARTS ============

// Bought-in hardware consumed per unit rather than per gram: NFC tags, heat-set
// inserts, keyrings, keyboard switches, magnets, packaging, etc. Filament stays
// on the Material/Spool (weight-based) track; this is the discrete-count track.
model Part {
  id            String           @id @default(cuid())
  name          String
  sku           String?          @unique
  category      PartCategory     @default(OTHER)
  description   String?
  unitCost      Float            @default(0) // cost per piece
  stockQty      Int              @default(0)
  reorderPoint  Int              @default(0)
  supplier      String?
  locationId    String?
  location      StorageLocation? @relation(fields: [locationId], references: [id])
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  productParts  ProductPart[]
  jobParts      JobPart[]

  @@index([isActive])
  @@index([category])
  @@index([locationId])
}

enum PartCategory {
  FASTENER    // heat-set inserts, screws, nuts
  ELECTRONICS // NFC tags, LEDs, batteries
  HARDWARE    // keyrings, chains, magnets
  SWITCH      // keyboard switches
  PACKAGING
  ADHESIVE
  OTHER
}

// BOM line: how many of a Part each unit of a Product consumes.
model ProductPart {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  partId    String
  part      Part    @relation(fields: [partId], references: [id])
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@unique([productId, partId])
  @@index([productId])
}

// Parts actually consumed by a production job. unitCost is snapshotted so past
// job costs stay accurate when part pricing changes later.
model JobPart {
  id        String        @id @default(cuid())
  jobId     String
  job       ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partId    String
  part      Part          @relation(fields: [partId], references: [id])
  quantity  Int
  unitCost  Float
  createdAt DateTime      @default(now())

  @@index([jobId])
  @@index([partId])
}

// ============ PRODUCTS (BOM) ============

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?
  sku               String?  @unique
  estimatedMinutes  Float    @default(0)
  estimatedGrams    Float    @default(0)
  colorChanges      Int      @default(0)
  basePrice         Float    @default(0)
  imageUrl          String?
  isActive          Boolean  @default(true)
  defaultPrinterId  String?
  defaultPrinter    Printer? @relation(fields: [defaultPrinterId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants          ProductVariant[]
  components        ProductComponent[]
  parts             ProductPart[]
  productionJobs    ProductionJob[]
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  sku              String?  @unique
  basePrice        Float?
  estimatedMinutes Float?
  estimatedGrams   Float?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems       OrderItem[]
  productionJobs   ProductionJob[]

  @@index([productId])
}

model ProductComponent {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id])
  description     String
  gramsUsed       Float
  printMinutes    Float    @default(0)
  quantity        Int      @default(1)
  sortOrder       Int      @default(0)
  stockOnHand     Int      @default(0)
  isMultiColor    Boolean  @default(false)
  // The slicer file this component was onboarded from. Kept so a production
  // job can pre-fill its filename and colour changes, and so the operator can
  // download the exact file to print. attachmentId points at the stored bytes.
  gcodeFilename   String?
  colorChanges    Int      @default(0)
  attachmentId    String?
  createdAt       DateTime @default(now())

  materials       ComponentMaterial[]
  productionJobs  ProductionJob[]
}

model ComponentMaterial {
  id              String           @id @default(cuid())
  componentId     String
  component       ProductComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material         @relation(fields: [materialId], references: [id])
  gramsUsed       Float
  colorIndex      Int              @default(0)
  sortOrder       Int              @default(0)

  @@unique([componentId, colorIndex])
}

// ============ PRINTERS ============

model Printer {
  id              String              @id @default(cuid())
  name            String
  model           String?
  connectionType  PrinterConnectionType
  moonrakerUrl    String?
  cameraUrl       String?             // MJPEG stream URL (e.g. http://192.168.x.x:8000)
  hourlyRate      Float               @default(0.40)
  wattage         Float               @default(200)
  markupMultiplier Float              @default(2.5)
  isActive        Boolean             @default(true)
  status          PrinterStatus       @default(OFFLINE)
  lastSeen        DateTime?

  // Maintenance tracking
  totalPrintHours            Float    @default(0)
  maintenanceIntervalHours   Float?
  nextMaintenanceDue         DateTime? // kept for calendar-based reminders; overdue uses print-hour delta
  lastMaintenancePrintHours  Float    @default(0) // totalPrintHours at time of last completed maintenance

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  productionJobs  ProductionJob[]
  defaultProducts Product[]
  maintenanceLogs MaintenanceLog[]

  @@index([connectionType, isActive])
}

model MaintenanceLog {
  id              String              @id @default(cuid())
  printerId       String
  printer         Printer             @relation(fields: [printerId], references: [id], onDelete: Cascade)
  type            MaintenanceType
  description     String
  scheduledDate   DateTime?
  completedDate   DateTime?
  downtimeMinutes Int?
  cost            Float?
  performedById   String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([printerId])
}

enum MaintenanceType {
  SCHEDULED
  UNSCHEDULED
  CALIBRATION
}

enum PrinterConnectionType {
  MOONRAKER
  CREALITY_WS
  CREALITY_CLOUD
  MANUAL
}

enum PrinterStatus {
  IDLE
  PRINTING
  PAUSED
  ERROR
  OFFLINE
  MAINTENANCE
}

// ============ PRODUCTION ============

model ProductionJob {
  id              String     @id @default(cuid())
  name            String
  status          JobStatus  @default(QUEUED)
  printerId       String?
  printer         Printer?   @relation(fields: [printerId], references: [id])
  assignedToId    String?
  assignedTo      User?      @relation(fields: [assignedToId], references: [id])
  orderId         String?
  order           Order?     @relation(fields: [orderId], references: [id])
  orderItemId     String?
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id])
  productId       String?
  product         Product?   @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  componentId     String?
  component       ProductComponent? @relation(fields: [componentId], references: [id])
  quantityToProduce Int      @default(1)
  // Why this job exists. TEST/SAMPLE/WASTE prints still consume filament and
  // parts, but are excluded from revenue and cost-of-sales reporting so they
  // don't distort margins.
  purpose         JobPurpose @default(CUSTOMER)

  printDuration   Float?
  filamentUsedMm  Float?

  colorChanges    Int        @default(0)
  purgeWasteGrams Float      @default(0)

  materialCost    Float?
  machineCost     Float?
  wasteCost       Float?
  overheadCost    Float?
  totalCost       Float?

  moonrakerJobId  String?
  gcodeFilename   String?

  // Failed print tracking
  failureReason   String?
  failedAt        DateTime?
  wasteGrams      Float      @default(0)
  reprintOfId     String?
  reprintOf       ProductionJob?  @relation("Reprints", fields: [reprintOfId], references: [id])
  reprints        ProductionJob[] @relation("Reprints")

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  materials       JobMaterial[]
  parts           JobPart[]
  attachments     Attachment[]

  @@index([status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([reprintOfId])
  @@index([printerId])
  @@index([printerId, status])
  @@index([completedAt])
}

enum JobStatus {
  QUEUED
  IN_PROGRESS
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobPurpose {
  CUSTOMER // real work — counts toward cost of sales
  TEST     // calibration / test print
  SAMPLE   // giveaway or showcase piece
  WASTE    // reprint of a failure, purge, etc.
}

model JobMaterial {
  id              String        @id @default(cuid())
  jobId           String
  job             ProductionJob @relation(fields: [jobId], references: [id])
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id])
  spoolId         String?
  spool           Spool?        @relation(fields: [spoolId], references: [id])
  gramsUsed       Float
  costPerGram     Float
  colorIndex      Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([jobId])
  @@index([materialId])
}

// ============ ORDERS ============

model Quote {
  id              String       @id @default(cuid())
  quoteNumber     String       @unique
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  status          QuoteStatus  @default(DRAFT)
  source          QuoteSource  @default(MANUAL)
  subtotal        Float        @default(0)
  tax             Float        @default(0)
  total           Float        @default(0)
  notes           String?
  validUntil      DateTime?
  gcodeMetadata   Json?
  stlMetadata     Json?
  costBreakdown   Json?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           QuoteItem[]
  order           Order?
  attachments     Attachment[]
  designProject   DesignProject?

  @@index([status])
  @@index([customerId])
}

enum QuoteSource {
  MANUAL
  QUICK_QUOTE
  CUSTOMER
  DESIGN
  LINK
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id                 String   @id @default(cuid())
  quoteId            String
  quote              Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId          String?
  description        String
  quantity           Int      @default(1)
  unitPrice          Float
  totalPrice         Float
  estimatedGrams     Float?
  estimatedMinutes   Float?
  estimatedColors    Int?
  estimatedCost      Float?
  marginPercent      Float?
  createdAt          DateTime @default(now())

  @@index([quoteId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  quoteId         String?     @unique
  quote           Quote?      @relation(fields: [quoteId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotal        Float       @default(0)
  tax             Float       @default(0)
  total           Float       @default(0)
  paidAmount      Float       @default(0)
  notes           String?
  dueDate         DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  productionJobs  ProductionJob[]
  invoices        Invoice[]
  attachments     Attachment[]
  configOrders    ConfigOrder[]

  @@index([status])
  @@index([customerId])
}

// ============ CONFIGURATOR ARTIFACTS ============

// A parametric-configurator submission tied to an order. The customer sends
// ONLY params; the server regenerates the artifact from them. params is the
// source of truth — artifacts are derived data and can be re-generated.
model ConfigOrder {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  generatorKey String
  params       Json     // validated parameter set (source of truth)
  status       String   @default("GENERATED") // GENERATED | FAILED
  createdAt    DateTime @default(now())

  artifacts    ConfigArtifact[]

  @@index([orderId])
}

// A single generated file (.stl / .3mf). storageKey is a server-generated
// opaque token used as the on-disk name — NO customer input ever reaches the
// path. filename is the human-friendly name for Content-Disposition only.
model ConfigArtifact {
  id            String      @id @default(cuid())
  configOrderId String
  configOrder   ConfigOrder @relation(fields: [configOrderId], references: [id], onDelete: Cascade)
  filename      String      // validated, for download header only — never a path
  mime          String
  sizeBytes     Int
  storageKey    String      @unique // opaque random token = on-disk filename
  createdAt     DateTime    @default(now())

  @@index([configOrderId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  description     String
  quantity        Int             @default(1)
  unitPrice       Float
  totalPrice      Float
  materialCost    Float?
  createdAt       DateTime        @default(now())

  productionJobs  ProductionJob[]

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  status          InvoiceStatus @default(DRAFT)
  subtotal        Float
  tax             Float
  total           Float
  paidAmount      Float         @default(0)
  issuedAt        DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments     Attachment[]
  transactions    AccountTransaction[]

  @@index([status, paidAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

// ============ ACCOUNTING ============

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  expenses    Expense[]
}

model Expense {
  id           String          @id @default(cuid())
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  description  String
  amount       Float
  date         DateTime
  recurring    Boolean         @default(false)
  notes        String?
  // Which account the money left. Optional so historical expenses recorded
  // before accounts existed stay valid.
  accountId    String?
  account      Account?        @relation(fields: [accountId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  transactions AccountTransaction[]

  @@index([categoryId])
  @@index([date])
  @@index([accountId])
}

// ============ ACCOUNTS ============

// A place money actually sits — a bank account, the cash box, a card.
// `balance` is a running total kept in step with AccountTransaction, so the
// current figure is one read rather than a sum over all history.
model Account {
  id          String      @id @default(cuid())
  name        String
  type        AccountType @default(BANK)
  // Free-text: IBAN, last 4 digits, whatever identifies it.
  reference   String?
  balance     Float       @default(0)
  // Where invoice payments land unless told otherwise. Only one may be true.
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactions AccountTransaction[]
  expenses     Expense[]

  @@index([isActive])
}

enum AccountType {
  BANK
  CASH
  CARD
  OTHER
}

// Every movement of money, positive in and negative out.
//
// `balanceAfter` snapshots the running balance at the time, so a statement
// reads correctly even after later edits, and a drifted Account.balance can be
// spotted against it.
model AccountTransaction {
  id           String          @id @default(cuid())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Positive credits the account, negative debits it.
  amount       Float
  balanceAfter Float
  type         TransactionType
  description  String
  // Human reference — invoice number, receipt number.
  reference    String?
  invoiceId    String?
  invoice      Invoice?        @relation(fields: [invoiceId], references: [id])
  expenseId    String?
  expense      Expense?        @relation(fields: [expenseId], references: [id])
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@index([accountId, occurredAt])
  @@index([invoiceId])
  @@index([expenseId])
}

enum TransactionType {
  INVOICE_PAYMENT
  EXPENSE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  OPENING_BALANCE
}

// ============ FILE MANAGEMENT ============

model Attachment {
  id              String   @id @default(cuid())
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  storagePath     String
  entityType      String
  entityId        String
  parsedMetadata  Json?
  uploadedById    String?
  createdAt       DateTime @default(now())

  // Polymorphic relation — entityType + entityId reference different tables
  // (Quote, Order, ProductionJob, DesignProject, Invoice) without FK constraints
  quoteId         String?
  quote           Quote?         @relation(fields: [quoteId], references: [id])
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id])
  jobId           String?
  productionJob   ProductionJob? @relation(fields: [jobId], references: [id])
  designProjectId String?
  designProject   DesignProject? @relation(fields: [designProjectId], references: [id])
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([entityType, entityId])
}

// ============ DESIGN MODULE (groundwork) ============

model DesignProject {
  id                String       @id @default(cuid())
  projectNumber     String       @unique
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id])
  assignedToId      String?
  assignedTo        User?        @relation("DesignAssignments", fields: [assignedToId], references: [id])
  status            DesignStatus @default(REQUESTED)
  title             String
  brief             String?
  budget            Float?
  quotedPrice       Float?
  designFeeType     DesignFeeType @default(FLAT)
  designFeeAmount   Float?
  designFeeHours    Float?
  totalDesignFee    Float?
  estimatedDelivery DateTime?
  quoteId           String?      @unique
  quote             Quote?       @relation(fields: [quoteId], references: [id])
  deadline          DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  revisions         DesignRevision[]
  comments          DesignComment[]
  attachments       Attachment[]

  @@index([status])
  @@index([customerId])
  @@index([assignedToId])
}

enum DesignFeeType {
  FLAT
  HOURLY
}

enum DesignStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  QUOTED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model DesignRevision {
  id              String        @id @default(cuid())
  projectId       String
  project         DesignProject @relation(fields: [projectId], references: [id])
  versionNumber   Int
  description     String?
  internalNotes   String?
  customerNotes   String?
  createdAt       DateTime      @default(now())

  comments        DesignComment[]
}

model DesignComment {
  id              String          @id @default(cuid())
  projectId       String
  project         DesignProject   @relation(fields: [projectId], references: [id])
  revisionId      String?
  revision        DesignRevision? @relation(fields: [revisionId], references: [id])
  authorId        String?
  authorName      String
  isCustomer      Boolean         @default(false)
  content         String
  attachmentIds   String[]
  createdAt       DateTime        @default(now())
}

// ============ SYSTEM ============

model SystemSetting {
  id      String @id @default(cuid())
  key     String @unique
  value   String
}

// ============ ADDONS ============

// An operator-uploaded mini-app served in an iframe under /addons/{slug}.
// Static files live on disk at ${UPLOAD_DIR}/addons/{slug}/; this row is the
// registry entry that drives the sidebar and the addon host page.
model Addon {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?  // lucide-react icon name, e.g. "Type"
  version     String   @default("0.0.0")
  entry       String   @default("index.html")
  isActive    Boolean  @default(true)
  // Whether customers can see and open this addon in the portal. Defaults to
  // false so a newly uploaded addon is staff-only until explicitly published —
  // internal tools (e.g. 3mf-orca-prep) simply stay off.
  customerVisible Boolean @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean          @default(false)
  userId      String?
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
